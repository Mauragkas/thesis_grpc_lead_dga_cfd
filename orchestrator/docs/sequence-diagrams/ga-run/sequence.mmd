sequenceDiagram
    participant Main as main()
    participant Runner as GaRunner::run()
    participant Tracker as ProgressTracker
    participant Mig as MigrationHook
    participant Ops as ga::operators
    participant Store as GeneStore
    participant Eval as Evaluator
    participant NStore as NeighborStore
    participant Normal as rand_distr::Normal

    Main->>Runner: run(&mut rng)
    Runner->>Ops: random_population(rng, cfg)
    Ops-->>Runner: population

    Runner->>Normal: Normal::new(0.0, cfg.mut_sigma)
    Runner->>Tracker: ProgressTracker::new(patience, min_improvement, min_generations)

    loop for gen in 1..=cfg.max_generations
        opt migration is Some(...)
            Runner->>Mig: drain_immigrants()
            Mig-->>Runner: immigrants
            alt immigrants not empty
                Runner->>Runner: integrate immigrants into population
            end
        end

        loop for each individual in population
            Runner->>Store: lookup_exact(genes, gen)
            alt cache hit
                Store-->>Runner: Some(fitness)
            else cache miss
                Store-->>Runner: None
                Runner->>Runner: collect uncached genes
            end
        end

        alt uncached individuals exist
            Runner->>Eval: evaluate_population(&uncached)
            Eval-->>Runner: fresh fitnesses

            loop for each fresh result
                Runner->>Store: store(genes, fitness, gen)
                opt neighbor_store is Some(...)
                    Runner->>NStore: store(genes, fitness, gen)
                end
            end
        end

        Runner->>Store: evict_expired(gen)
        Runner->>Runner: record_generation_stats(gen, best_ever, best_genome)

        opt migration is Some(...)
            Runner->>Mig: maybe_emigrate(gen, &population, &fitnesses)
        end

        Runner->>Tracker: update(best_ever, gen)
        opt tracker converged (stagnated >= patience and gen >= min_generations)
            Runner->>Runner: log convergence & break early
        end

        Runner->>Ops: select_survivors(&population, &fitnesses, cfg)
        Ops-->>Runner: survivors
        Runner->>Ops: next_generation(&survivors, cfg, rng, &normal)
        Ops-->>Runner: next population
    end

    Runner-->>Main: Ok(GaResult { best_fitness, best_genome })

