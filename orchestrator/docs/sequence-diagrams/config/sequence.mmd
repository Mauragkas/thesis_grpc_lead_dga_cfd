sequenceDiagram
    participant Env as std::env
    participant ConfigFn as config::config_from_env()
    participant GaCfg as GaConfig
    participant TransportCfg as TransportConfig
    participant StoreCfg as GeneStoreConfig
    participant LeadCfg as LeadConfig
    participant SurrCfg as SurrogateClientConfig
    participant TierCfg as TierConfig
    participant RingCfg as RingConfig
    participant MigCfg as MigrationConfig

    ConfigFn->>GaCfg: GaConfig::default()
    ConfigFn->>TransportCfg: TransportConfig::default()
    ConfigFn->>StoreCfg: GeneStoreConfig::default()
    ConfigFn->>LeadCfg: LeadConfig::default()
    ConfigFn->>SurrCfg: SurrogateClientConfig::default()
    ConfigFn->>TierCfg: TierConfig::default()
    ConfigFn->>RingCfg: RingConfig::default()
    ConfigFn->>MigCfg: MigrationConfig::default()

    opt EVAL_ENDPOINT is set
        ConfigFn->>Env: var("EVAL_ENDPOINT")
        Env-->>ConfigFn: endpoint
        ConfigFn->>GaCfg: ga.eval_endpoint = endpoint
    end

    opt GA_SEED is set and parses as u64
        ConfigFn->>Env: var("GA_SEED")
        Env-->>ConfigFn: seed string
        ConfigFn->>GaCfg: ga.seed = parsed_seed
    end

    opt MAX_GENERATIONS / GA_GENERATIONS is set and parses as usize
        ConfigFn->>Env: var("MAX_GENERATIONS")
        Env-->>ConfigFn: gen string
        ConfigFn->>GaCfg: ga.max_generations = parsed_gen
    end

    opt MIN_GENERATIONS / GA_MIN_GENERATIONS is set and parses as usize
        ConfigFn->>Env: var("MIN_GENERATIONS")
        Env-->>ConfigFn: min_gen string
        ConfigFn->>GaCfg: ga.min_generations = parsed_min_gen
    end

    opt STAGNATION_PATIENCE / GA_STAGNATION_PATIENCE is set and parses as usize
        ConfigFn->>Env: var("STAGNATION_PATIENCE")
        Env-->>ConfigFn: patience string
        ConfigFn->>GaCfg: ga.stagnation_patience = parsed_patience
    end

    opt MIN_IMPROVEMENT / GA_MIN_IMPROVEMENT is set and parses as f64
        ConfigFn->>Env: var("MIN_IMPROVEMENT")
        Env-->>ConfigFn: imp string
        ConfigFn->>GaCfg: ga.min_improvement = parsed_imp
    end

    opt Transport Resilience Overrides
        ConfigFn->>Env: var("CIRCUIT_BREAKER_FAILURE_THRESHOLD")
        Env-->>ConfigFn: threshold string
        ConfigFn->>TransportCfg: circuit_breaker_failure_threshold = parsed

        ConfigFn->>Env: var("CIRCUIT_BREAKER_RECOVERY_TIMEOUT_MS")
        Env-->>ConfigFn: ms string
        ConfigFn->>TransportCfg: circuit_breaker_recovery_timeout = ms

        ConfigFn->>Env: var("MAX_INDIVIDUAL_RETRIES")
        Env-->>ConfigFn: retries string
        ConfigFn->>TransportCfg: max_individual_retries = parsed

        ConfigFn->>Env: var("FALLBACK_PENALTY_ON_EXHAUSTION")
        Env-->>ConfigFn: bool string
        ConfigFn->>TransportCfg: fallback_penalty_on_exhaustion = parsed
    end

    opt GENE_STORE_MAX_AGE is set and parses as usize
        ConfigFn->>Env: var("GENE_STORE_MAX_AGE")
        Env-->>ConfigFn: age string
        ConfigFn->>StoreCfg: store.max_age_generations = parsed_age
    end

    opt LEAD_ENDPOINT is set
        ConfigFn->>Env: var("LEAD_ENDPOINT")
        Env-->>ConfigFn: endpoint
        ConfigFn->>LeadCfg: lead.endpoint = Some(endpoint)
    end

    opt SURROGATE_ENDPOINT is set
        ConfigFn->>Env: var("SURROGATE_ENDPOINT")
        Env-->>ConfigFn: endpoint
        ConfigFn->>SurrCfg: surrogate.endpoint = Some(endpoint)
    end

    opt Tier Config Overrides
        ConfigFn->>Env: var("TIER_EPSILON_EXACT")
        Env-->>ConfigFn: eps string
        ConfigFn->>TierCfg: tier.epsilon_exact = parsed

        ConfigFn->>Env: var("TIER_RADIUS_R")
        Env-->>ConfigFn: r string
        ConfigFn->>TierCfg: tier.radius_r = parsed

        ConfigFn->>Env: var("TIER_K_NEIGHBORS")
        Env-->>ConfigFn: k string
        ConfigFn->>TierCfg: tier.k_neighbors = parsed
    end

    opt RING_BIND is set
        ConfigFn->>Env: var("RING_BIND")
        Env-->>ConfigFn: addr
        ConfigFn->>RingCfg: ring.bind_address = addr
    end

    opt RING_SELF_ADDRESS is set
        ConfigFn->>Env: var("RING_SELF_ADDRESS")
        Env-->>ConfigFn: addr
        ConfigFn->>RingCfg: ring.self_address = addr
    end

    opt RING_BOOTSTRAP is set
        ConfigFn->>Env: var("RING_BOOTSTRAP")
        Env-->>ConfigFn: addr
        ConfigFn->>RingCfg: ring.bootstrap_address = Some(addr)
    end

    opt MIGRATION_INTERVAL is set and parses as usize
        ConfigFn->>Env: var("MIGRATION_INTERVAL")
        Env-->>ConfigFn: interval string
        ConfigFn->>MigCfg: migration.interval_generations = parsed_interval
    end

    opt MIGRATION_COUNT is set and parses as usize
        ConfigFn->>Env: var("MIGRATION_COUNT")
        Env-->>ConfigFn: count string
        ConfigFn->>MigCfg: migration.migrant_count = parsed_count
    end

    ConfigFn-->>ConfigFn: return (GaConfig, TransportConfig, GeneStoreConfig, LeadConfig, SurrogateClientConfig, TierConfig, RingConfig, MigrationConfig)

